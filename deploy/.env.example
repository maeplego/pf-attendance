ATTENDANCE_STORE=jpa
ATTENDANCE_DEV_AUTH=true
ATTENDANCE_CORS_ORIGIN=http://localhost:3019
ATTENDANCE_SEED_DEMO=true
ATTENDANCE_DATASOURCE_URL=jdbc:postgresql://attendance-db:5432/attendance
# Browser (client components): http://localhost:8019
# NEXT_PUBLIC_ATTENDANCE_API_URL=http://localhost:8019
# Server-side proxy in attendance-web container:
# ATTENDANCE_API_URL=http://attendance-api:8019

# OIDC（P01 pf-identity と併用。web に OIDC_* を渡すとホストログイン必須）
# ATTENDANCE_DEV_AUTH=false
# ATTENDANCE_OIDC_ISSUER=http://localhost:8080
# ATTENDANCE_OIDC_INTERNAL_BASE=http://host.docker.internal:8080
# ATTENDANCE_OIDC_AUDIENCE=pf-attendance-web
# OIDC_ISSUER=http://localhost:8080
# OIDC_INTERNAL_BASE=http://host.docker.internal:8080
# OIDC_CLIENT_ID=pf-attendance-web
# OIDC_REDIRECT_URI=http://localhost:3019/callback
# OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3019/logged-out
